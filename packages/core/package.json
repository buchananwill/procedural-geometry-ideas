{
  "name": "@proc-geo/core",
  "version": "0.1.0",
  "description": "Procedural geometry algorithms — straight skeleton, random polygon generation, and more",
  "license": "MIT",
  "author": "Will Buchanan <willwritescode@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchananwill/procedural-geometry-ideas",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/buchananwill/procedural-geometry-ideas#readme",
  "bugs": "https://github.com/buchananwill/procedural-geometry-ideas/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest"
  },
  "dependencies": {
    "loglevel": "^1.9.2"
  },
  "devDependencies": {
    "@proc-geo/test-fixtures": "workspace:*",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
