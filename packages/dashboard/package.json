{
  "name": "@proc-geo/dashboard",
  "version": "0.1.0",
  "description": "React component library for exploring procedural geometry algorithms",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@proc-geo/core": "workspace:*",
    "@proc-geo/test-fixtures": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "konva": "^10",
    "react-konva": "^19",
    "zustand": "^5",
    "immer": "^11"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "immer": "^11.1.4",
    "konva": "^10.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.2",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "zustand": "^5.0.11"
  }
}
