{
  "name": "@proc-geo/dashboard",
  "version": "0.1.0",
  "description": "React component library for exploring procedural geometry algorithms",
  "license": "MIT",
  "author": "Will Buchanan <willwritescode@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/buchananwill/procedural-geometry-ideas",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/buchananwill/procedural-geometry-ideas#readme",
  "bugs": "https://github.com/buchananwill/procedural-geometry-ideas/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.3.2",
    "@phosphor-icons/react": "^2.1.10",
    "@proc-geo/core": "workspace:*",
    "@proc-geo/test-fixtures": "workspace:*"
  },
  "peerDependencies": {
    "@mantine/core": "^8",
    "@mantine/hooks": "^8",
    "immer": "^11",
    "konva": "^10",
    "react": "^19",
    "react-dom": "^19",
    "react-konva": "^19",
    "zustand": "^5"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "@types/jest": "^30.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "immer": "^11.1.4",
    "jest": "^30.2.0",
    "konva": "^10.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.2",
    "ts-jest": "^29.4.6",
    "tsup": "^8.4.0",
    "typescript": "^5",
    "zustand": "^5.0.11"
  }
}
