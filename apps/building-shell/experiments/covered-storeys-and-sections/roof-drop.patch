+// EXPERIMENT ONLY, not adopted: the candidate rule's plan-cover test, exact on the rectilinear coordinate grid of both plans.
+import type {Pt} from './roof/model.ts';
+
+const inside = (p: Pt, loops: Pt[][]): boolean => {
+  let odd = false;
+  for (const l of loops) {
+    for (let i = 0; i < l.length; i++) {
+      const a = l[i], b = l[(i + 1) % l.length];
+      if ((a.y > p.y) !== (b.y > p.y) && p.x < a.x + ((p.y - a.y) / (b.y - a.y)) * (b.x - a.x)) odd = !odd;
+    }
+  }
+  return odd;
+};
+
+/** Whether every part of the plan bounded by `loops` lies inside the plan bounded by `upper`. */
+export function planCovered(loops: Pt[][], upper: Pt[][]): boolean {
+  if (!upper.length) return false;
+  const all = [...loops, ...upper].flat();
+  const xs = [...new Set(all.map(p => p.x))].sort((a, b) => a - b);
+  const ys = [...new Set(all.map(p => p.y))].sort((a, b) => a - b);
+  for (let i = 0; i + 1 < xs.length; i++) {
+    for (let j = 0; j + 1 < ys.length; j++) {
+      const c = {x: (xs[i] + xs[i + 1]) / 2, y: (ys[j] + ys[j + 1]) / 2};
+      if (inside(c, loops) && !inside(c, upper)) return false;
+    }
+  }
+  return true;
+}
